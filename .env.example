# ── Authentication ────────────────────────────────────────────────────────────
#
# Option A: Gemini API (default — simplest setup)
#   Get your key at https://aistudio.google.com/app/apikey
#
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=0

# Option B: Google Cloud Vertex AI
#   Uncomment and fill in the values below, then set GOOGLE_GENAI_USE_VERTEXAI=1
#   Requires: gcloud auth application-default login
#
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# GOOGLE_CLOUD_LOCATION=us-central1

# ── Storage ───────────────────────────────────────────────────────────────────
#
# Path to the SQLite database file.
# Defaults to expenses.db in the current working directory.
#
# EXPENSE_DB_PATH=expenses.db

# Path to the directory where CSV exports are written.
# Defaults to exports/ in the current working directory.
#
# EXPENSE_EXPORTS_DIR=exports
